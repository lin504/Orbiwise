# Milvus向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis配置（用于会话缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# 阿里云千问大模型API配置（DashScope OpenAI兼容接口）
ALIYUN_API_KEY=your-aliyun-api-key-here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# Embedding模型配置（阿里云DashScope文本向量，与千问共用API Key）
EMBEDDING_MODEL_NAME=text-embedding-v3

# Milvus集合名称
MILVUS_COLLECTION_NAME=travel_rag

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
